{
  "rules": {
    ".read": false,
    ".write": false,

    "daily": {
      "$slug": {
        "$day": {
          "board": { ".indexOn": ["ms"] }
        }
      }
    },

    "games": {
      "$room": {
        ".read": "auth != null",

        "meta": {
          ".write": "auth != null && !data.exists() && $room.matches(/^[a-hjkmnp-z1-9][a-hjkmnp-z1-9][a-hjkmnp-z1-9][a-hjkmnp-z1-9][a-hjkmnp-z1-9][a-hjkmnp-z1-9]$/)",
          ".validate": "newData.hasChildren(['gameSlug', 'maxPlayers', 'createdAt', 'createdBy']) && !root.child('games/' + $room + '/closedAt').exists()",
          "gameSlug": { ".validate": "newData.val() == 'ftw' || newData.val() == 'cocounsel' || newData.val() == 'nighthighway' || newData.val() == 'buzzerquiz' || newData.val() == 'wordscramble'" },
          "maxPlayers": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 8 && ((newData.parent().child('gameSlug').val() != 'ftw' && newData.parent().child('gameSlug').val() != 'cocounsel' && newData.parent().child('gameSlug').val() != 'nighthighway') || newData.val() == 2) && (newData.parent().child('gameSlug').val() != 'buzzerquiz' || newData.val() == 4) && (newData.parent().child('gameSlug').val() != 'wordscramble' || newData.val() == 8)" },
          "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
          "createdBy": { ".validate": "newData.val() == auth.uid" },
          "name": {
            ".write": "auth != null && data.parent().child('createdBy').val() == auth.uid",
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40 && newData.parent().child('nameKey').exists()"
          },
          "nameKey": {
            ".write": "auth != null && data.parent().child('createdBy').val() == auth.uid",
            ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 40 && newData.val().matches(/^[a-z0-9-]+$/) && newData.parent().parent().parent().parent().child('roomsByName/' + newData.val()).val() == $room"
          },
          "publicLang": { ".validate": "((newData.val() == 'en' || newData.val() == 'fr') && (newData.parent().child('gameSlug').val() == 'buzzerquiz' || newData.parent().child('gameSlug').val() == 'wordscramble')) || (newData.val() == 'any' && newData.parent().child('gameSlug').val() == 'nighthighway')" },
          "$other": { ".validate": false }
        },

        "seats": {
          ".validate": "!root.child('games/' + $room + '/closedAt').exists()",
          "$seat": {
            ".write": "auth != null && ((!data.exists() && newData.val() == auth.uid && newData.parent().parent().child('members/' + auth.uid).val() == $seat && (!root.child('games/' + $room + '/members/' + auth.uid).exists() || newData.parent().child(root.child('games/' + $room + '/members/' + auth.uid).val() + '').val() != auth.uid)) || (data.val() == auth.uid && !newData.exists() && newData.parent().parent().child('members/' + auth.uid).val() != $seat) || (data.exists() && data.val() != auth.uid && newData.val() == auth.uid && newData.parent().parent().child('members/' + auth.uid).val() == $seat && !newData.parent().parent().child('members/' + data.val()).exists() && root.child('games/' + $room + '/presence/' + data.val() + '/online').val() == false && root.child('games/' + $room + '/presence/' + data.val() + '/lastSeen').val() < now - 120000 && (!root.child('games/' + $room + '/members/' + auth.uid).exists() || newData.parent().child(root.child('games/' + $room + '/members/' + auth.uid).val() + '').val() != auth.uid)) || (data.exists() && newData.exists() && root.child('games/' + $room + '/members/' + auth.uid).exists() && newData.parent().parent().child('members/' + auth.uid).exists() && root.child('games/' + $room + '/members/' + newData.val()).exists() && newData.parent().parent().child('members/' + newData.val()).val() == $seat && newData.parent().parent().child('members/' + data.val()).exists() && newData.parent().parent().child('members/' + data.val()).val() != $seat))",
            ".validate": "newData.isString() && ($seat == 'p1' || $seat == 'p2' || ($seat == 'p3' && newData.parent().parent().child('meta/maxPlayers').val() >= 3) || ($seat == 'p4' && newData.parent().parent().child('meta/maxPlayers').val() >= 4) || ($seat == 'p5' && newData.parent().parent().child('meta/maxPlayers').val() >= 5) || ($seat == 'p6' && newData.parent().parent().child('meta/maxPlayers').val() >= 6) || ($seat == 'p7' && newData.parent().parent().child('meta/maxPlayers').val() >= 7) || ($seat == 'p8' && newData.parent().parent().child('meta/maxPlayers').val() >= 8))"
          }
        },

        "members": {
          ".validate": "!root.child('games/' + $room + '/closedAt').exists()",
          "$uid": {
            ".write": "auth != null && (($uid == auth.uid && newData.exists() && newData.parent().parent().child('seats/' + newData.val()).val() == auth.uid) || (!newData.exists() && newData.parent().parent().child('seats/' + data.val()).val() != $uid) || ($uid != auth.uid && data.exists() && newData.exists() && root.child('games/' + $room + '/members/' + auth.uid).exists() && newData.parent().parent().child('seats/' + newData.val()).val() == $uid))",
            ".validate": "newData.isString() && newData.val().matches(/^p[1-8]$/)"
          }
        },

        "players": {
          ".validate": "!root.child('games/' + $room + '/closedAt').exists()",
          "$seat": {
            ".write": "auth != null && newData.parent().parent().child('seats/' + $seat).val() == auth.uid",
            ".validate": "newData.hasChildren(['name'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24" },
            "$other": { ".validate": false }
          }
        },

        "presence": {
          "$uid": {
            ".write": "auth != null && $uid == auth.uid && (!newData.exists() || newData.parent().parent().child('members/' + auth.uid).exists())",
            ".validate": "newData.hasChildren(['online', 'lastSeen'])",
            "online": { ".validate": "newData.isBoolean()" },
            "lastSeen": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        },

        "autoStart": {
          ".write": "auth != null && data.parent().child('meta/publicLang').exists() && root.child('games/' + $room + '/members/' + auth.uid).exists()",
          ".validate": "newData.isNumber() && newData.val() <= now + 60000 && !root.child('games/' + $room + '/closedAt').exists()"
        },

        "lastActive": {
          ".write": "auth != null && newData.parent().child('members/' + auth.uid).exists()",
          ".validate": "newData.isNumber() && newData.val() <= now && !root.child('games/' + $room + '/closedAt').exists()"
        },

        "activeMinutes": {
          ".write": "auth != null && newData.exists() && root.child('games/' + $room + '/members/' + auth.uid).exists()",
          ".validate": "newData.hasChildren(['n', 'at']) && newData.child('at').val() == now && ((!data.exists() && newData.child('n').val() == 1) || (data.exists() && newData.child('n').val() == data.child('n').val() + 1 && data.child('at').val() <= now - 50000)) && !root.child('games/' + $room + '/closedAt').exists()",
          "n": { ".validate": "newData.isNumber()" },
          "at": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },

        "closedAt": {
          ".write": false,
          ".validate": "newData.isNumber()"
        },

        "ftw": {
          ".write": "auth != null && newData.parent().child('meta/gameSlug').val() == 'ftw' && (newData.parent().child('members/' + auth.uid).exists() || (!data.parent().child('meta').exists() && newData.parent().child('meta/createdBy').val() == auth.uid))",
          ".validate": "newData.hasChildren(['round', 'totals', 'current']) && !root.child('games/' + $room + '/closedAt').exists()",
          "round": {
            ".validate": "newData.isNumber()"
          },
          "totals": {
            ".validate": "newData.hasChildren(['p1', 'p2'])",
            "p1": {
              ".validate": "newData.isNumber()"
            },
            "p2": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          },
          "current": {
            ".validate": "newData.hasChildren(['prompt', 'items', 'status'])",
            "prompt": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120"
            },
            "items": {
              ".validate": "newData.hasChildren(['0', '1', '2', '3', '4'])",
              "$i": {
                ".validate": "$i.matches(/^[0-4]$/) && newData.hasChildren(['id', 'label'])",
                "id": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 64"
                },
                "label": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "status": {
              ".validate": "newData.val() == 'RANKING' || newData.val() == 'GUESSING' || newData.val() == 'REVEALED'"
            },
            "masterOrder": {
              ".validate": "newData.hasChildren(['0', '1', '2', '3', '4'])",
              "$i": {
                ".validate": "$i.matches(/^[0-4]$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 64"
              }
            },
            "guessOrder": {
              ".validate": "newData.hasChildren(['0', '1', '2', '3', '4'])",
              "$i": {
                ".validate": "$i.matches(/^[0-4]$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 64"
              }
            },
            "score": {
              ".validate": "newData.isNumber()"
            },
            "placed": {
              "$i": {
                ".validate": "$i.matches(/^[0-4]$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 64"
              }
            },
            "$other": {
              ".validate": false
            }
          },
          "usedPrompts": {
            "$i": {
              ".validate": "$i.matches(/^[0-9]+$/) && $i.length <= 4 && newData.isString() && newData.val().length >= 1 && newData.val().length <= 120"
            }
          },
          "history": {
            "$i": {
              ".validate": "$i.matches(/^[0-9]+$/) && $i.length <= 4 && newData.hasChildren(['round', 'prompt', 'score', 'master'])",
              "round": {
                ".validate": "newData.isNumber()"
              },
              "prompt": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120"
              },
              "score": {
                ".validate": "newData.isNumber()"
              },
              "master": {
                ".validate": "newData.val() == 'p1' || newData.val() == 'p2'"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "topics": {
            "$i": {
              ".validate": "$i.matches(/^[0-9]+$/) && $i.length <= 2 && newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
            }
          },
          "$other": {
            ".validate": false
          }
        },

        "cocounsel": {
          ".write": "auth != null && newData.parent().child('meta/gameSlug').val() == 'cocounsel' && (newData.parent().child('members/' + auth.uid).exists() || (!data.parent().child('meta').exists() && newData.parent().child('meta/createdBy').val() == auth.uid))",
          ".validate": "newData.hasChildren(['caseId', 'partIndex', 'attempts', 'phase']) && !root.child('games/' + $room + '/closedAt').exists()",
          "caseId": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "partIndex": {
            ".validate": "newData.isNumber()"
          },
          "attempts": {
            ".validate": "newData.isNumber()"
          },
          "phase": {
            ".validate": "newData.val() == 'SELECTING' || newData.val() == 'REVEALED' || newData.val() == 'CASE_DONE'"
          },
          "locks": {
            "p1": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
            },
            "p2": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
            },
            "$other": {
              ".validate": false
            }
          },
          "log": {
            "$i": {
              ".validate": "$i.matches(/^[0-9]+$/) && $i.length <= 4 && newData.hasChildren(['partIndex', 'investigatorCard', 'defendantCard', 'outcome', 'trustFlags', 'focusFlags'])",
              "partIndex": {
                ".validate": "newData.isNumber()"
              },
              "investigatorCard": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
              },
              "defendantCard": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
              },
              "outcome": {
                ".validate": "newData.val() == 'solved' || newData.val() == 'trap' || newData.val() == 'wrong' || newData.val() == 'judgeRevealed' || newData.val() == 'adjourned'"
              },
              "trustFlags": {
                ".validate": "newData.isNumber()"
              },
              "focusFlags": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "lastReveal": {
            ".validate": "newData.hasChildren(['outcome', 'investigatorCardId', 'defendantCardId'])",
            "outcome": {
              ".validate": "newData.val() == 'solved' || newData.val() == 'retry' || newData.val() == 'judgeRevealed' || newData.val() == 'adjourned'"
            },
            "investigatorCardId": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
            },
            "defendantCardId": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
            },
            "solvedOnFirstTry": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        },

        "nighthighway": {
          ".write": "auth != null && newData.parent().child('meta/gameSlug').val() == 'nighthighway' && (newData.parent().child('members/' + auth.uid).exists() || (!data.parent().child('meta').exists() && newData.parent().child('meta/createdBy').val() == auth.uid))",
          ".validate": "newData.hasChildren(['phase', 'race', 'wins']) && !root.child('games/' + $room + '/closedAt').exists()",
          "phase": { ".validate": "newData.val() == 'LOBBY' || newData.val() == 'RACING' || newData.val() == 'DONE'" },
          "race": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "ready": {
            "p1": { ".validate": "newData.val() == true" },
            "p2": { ".validate": "newData.val() == true" },
            "$other": { ".validate": false }
          },
          "seed": { ".validate": "newData.isNumber()" },
          "startAt": { ".validate": "newData.isNumber()" },
          "options": {
            "rain": { ".validate": "newData.isBoolean()" },
            "pickups": { ".validate": "newData.isBoolean()" },
            "desert": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          },
          "results": {
            "p1": {
              ".validate": "newData.hasChildren(['score', 'distance', 'top', 'avg', 'nearMiss', 'overtakes', 'crashes'])",
              "score": { ".validate": "newData.isNumber()" },
              "distance": { ".validate": "newData.isNumber()" },
              "top": { ".validate": "newData.isNumber()" },
              "avg": { ".validate": "newData.isNumber()" },
              "nearMiss": { ".validate": "newData.isNumber()" },
              "overtakes": { ".validate": "newData.isNumber()" },
              "crashes": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            },
            "p2": {
              ".validate": "newData.hasChildren(['score', 'distance', 'top', 'avg', 'nearMiss', 'overtakes', 'crashes'])",
              "score": { ".validate": "newData.isNumber()" },
              "distance": { ".validate": "newData.isNumber()" },
              "top": { ".validate": "newData.isNumber()" },
              "avg": { ".validate": "newData.isNumber()" },
              "nearMiss": { ".validate": "newData.isNumber()" },
              "overtakes": { ".validate": "newData.isNumber()" },
              "crashes": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            },
            "$other": { ".validate": false }
          },
          "wins": {
            ".validate": "newData.hasChildren(['p1', 'p2'])",
            "p1": { ".validate": "newData.isNumber()" },
            "p2": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          },
          "history": {
            "$i": {
              ".validate": "$i.matches(/^[0-9]+$/) && $i.length <= 4 && newData.hasChildren(['race', 'winner'])",
              "race": { ".validate": "newData.isNumber()" },
              "scores": {
                "p1": { ".validate": "newData.isNumber()" },
                "p2": { ".validate": "newData.isNumber()" },
                "$other": { ".validate": false }
              },
              "winner": { ".validate": "newData.val() == 'p1' || newData.val() == 'p2' || newData.val() == 'tie'" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        },

        "nighthighwayCars": {
          ".validate": "!root.child('games/' + $room + '/closedAt').exists()",
          "$seat": {
            ".write": "auth != null && root.child('games/' + $room + '/meta/gameSlug').val() == 'nighthighway' && root.child('games/' + $room + '/members/' + auth.uid).val() == $seat",
            ".validate": "newData.hasChildren(['race', 't', 's', 'x', 'v', 'score', 'paint'])",
            "race": { ".validate": "newData.isNumber()" },
            "t": { ".validate": "newData.isNumber()" },
            "s": { ".validate": "newData.isNumber()" },
            "x": { ".validate": "newData.isNumber()" },
            "v": { ".validate": "newData.isNumber()" },
            "score": { ".validate": "newData.isNumber()" },
            "paint": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "buzzerquiz": {
          ".write": "auth != null && newData.parent().child('meta/gameSlug').val() == 'buzzerquiz' && (newData.parent().child('members/' + auth.uid).exists() || (!data.parent().child('meta').exists() && newData.parent().child('meta/createdBy').val() == auth.uid))",
          ".validate": "newData.hasChildren(['phase', 'settings', 'seed', 'index', 'round']) && !root.child('games/' + $room + '/closedAt').exists()",
          "phase": { ".validate": "newData.val() == 'setup' || newData.val() == 'lobby' || newData.val() == 'countdown' || newData.val() == 'question' || newData.val() == 'buzzing' || newData.val() == 'answering' || newData.val() == 'result' || newData.val() == 'final'" },
          "settings": {
            ".validate": "newData.hasChildren(['lang', 'length'])",
            "lang": { ".validate": "newData.val() == 'en' || newData.val() == 'fr'" },
            "length": { ".validate": "newData.val() == 5 || newData.val() == 10 || newData.val() == 15 || newData.val() == 20" },
            "topics": {
              "$i": { ".validate": "$i.matches(/^[0-5]$/) && (newData.val() == 'geography' || newData.val() == 'cinema' || newData.val() == 'science' || newData.val() == 'sport' || newData.val() == 'music' || newData.val() == 'history')" }
            },
            "$other": { ".validate": false }
          },
          "players": {
            "$i": { ".validate": "$i.matches(/^[0-3]$/) && newData.isString() && newData.val().matches(/^p[1-4]$/)" }
          },
          "questionIds": {
            "$i": { ".validate": "$i.matches(/^1?[0-9]$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" }
          },
          "seed": { ".validate": "newData.isNumber()" },
          "index": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 20" },
          "round": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10" },
          "deadline": { ".validate": "newData.isNumber()" },
          "openedAt": { ".validate": "newData.isNumber()" },
          "questionEnd": { ".validate": "newData.isNumber()" },
          "timeLeft": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 15000" },
          "buzzes": {
            "$i": {
              ".validate": "$i.matches(/^[0-3]$/) && newData.hasChildren(['seat', 'ms'])",
              "seat": { ".validate": "newData.isString() && newData.val().matches(/^p[1-4]$/)" },
              "ms": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 15000" },
              "$other": { ".validate": false }
            }
          },
          "buzzer": { ".validate": "newData.isString() && newData.val().matches(/^p[1-4]$/)" },
          "struck": {
            "$i": { ".validate": "$i.matches(/^[0-2]$/) && newData.isNumber() && newData.val() >= 1 && newData.val() <= 3" }
          },
          "locked": {
            "$i": { ".validate": "$i.matches(/^[0-3]$/) && newData.isString() && newData.val().matches(/^p[1-4]$/)" }
          },
          "lastPick": {
            ".validate": "newData.hasChildren(['seat', 'choice', 'right'])",
            "seat": { ".validate": "newData.isString() && newData.val().matches(/^p[1-4]$/)" },
            "choice": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
            "right": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          },
          "outcome": {
            ".validate": "(newData.child('kind').val() == 'right' && newData.hasChildren(['seat', 'points'])) || (newData.child('kind').val() == 'none' && newData.hasChildren(['reason']))",
            "kind": { ".validate": "newData.val() == 'right' || newData.val() == 'none'" },
            "seat": { ".validate": "newData.isString() && newData.val().matches(/^p[1-4]$/)" },
            "points": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
            "reason": { ".validate": "newData.val() == 'one-left' || newData.val() == 'all-locked' || newData.val() == 'timeout'" },
            "$other": { ".validate": false }
          },
          "scores": {
            "$seat": { ".validate": "$seat.matches(/^p[1-4]$/) && newData.isNumber() && newData.val() >= 0" }
          },
          "$other": { ".validate": false }
        },

        "wordscramble": {
          ".write": "auth != null && newData.parent().child('meta/gameSlug').val() == 'wordscramble' && (newData.parent().child('members/' + auth.uid).exists() || (!data.parent().child('meta').exists() && newData.parent().child('meta/createdBy').val() == auth.uid))",
          ".validate": "newData.hasChildren(['phase', 'settings', 'turn', 'seed', 'hints', 'scores']) && !root.child('games/' + $room + '/closedAt').exists()",
          "phase": { ".validate": "newData.val() == 'lobby' || newData.val() == 'turn' || newData.val() == 'stealOffer' || newData.val() == 'stealing' || newData.val() == 'result' || newData.val() == 'scoreboard' || newData.val() == 'end'" },
          "settings": {
            ".validate": "newData.hasChildren(['lang', 'mode', 'turnsPerTeam', 'target'])",
            "lang": { ".validate": "newData.val() == 'en' || newData.val() == 'fr'" },
            "mode": { ".validate": "newData.val() == 'turns' || newData.val() == 'target'" },
            "turnsPerTeam": { ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 10" },
            "target": { ".validate": "newData.val() == 20 || newData.val() == 30 || newData.val() == 40" },
            "$other": { ".validate": false }
          },
          "teams": {
            "$seat": { ".validate": "$seat.matches(/^p[1-8]$/) && (newData.val() == 'A' || newData.val() == 'B')" }
          },
          "turn": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 40" },
          "wordId": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
          "seed": { ".validate": "newData.isNumber()" },
          "hints": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6" },
          "startAt": { ".validate": "newData.isNumber()" },
          "deadline": { ".validate": "newData.isNumber()" },
          "guesses": {
            "$i": {
              ".validate": "$i.matches(/^[12]?[0-9]$/) && newData.hasChildren(['seat', 'text'])",
              "seat": { ".validate": "newData.isString() && newData.val().matches(/^p[1-8]$/)" },
              "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12" },
              "$other": { ".validate": false }
            }
          },
          "found": {
            ".validate": "newData.hasChildren(['seat', 'ms'])",
            "seat": { ".validate": "newData.isString() && newData.val().matches(/^p[1-8]$/)" },
            "ms": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "$other": { ".validate": false }
          },
          "stealer": { ".validate": "newData.isString() && newData.val().matches(/^p[1-8]$/)" },
          "stolen": {
            ".validate": "newData.hasChildren(['seat', 'points'])",
            "seat": { ".validate": "newData.isString() && newData.val().matches(/^p[1-8]$/)" },
            "points": { ".validate": "newData.isNumber() && newData.val() >= -4 && newData.val() <= 4" },
            "$other": { ".validate": false }
          },
          "scores": {
            ".validate": "newData.hasChildren(['A', 'B'])",
            "A": { ".validate": "newData.isNumber() && newData.val() >= -999 && newData.val() <= 999" },
            "B": { ".validate": "newData.isNumber() && newData.val() >= -999 && newData.val() <= 999" },
            "$other": { ".validate": false }
          },
          "history": {
            "$i": {
              ".validate": "$i.matches(/^[0-3]?[0-9]$/) && newData.hasChildren(['team', 'wordId', 'points'])",
              "team": { ".validate": "newData.val() == 'A' || newData.val() == 'B'" },
              "wordId": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
              "points": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8" },
              "steal": { ".validate": "newData.isNumber() && newData.val() >= -4 && newData.val() <= 4" },
              "$other": { ".validate": false }
            }
          },
          "usedWordIds": {
            "$i": { ".validate": "$i.matches(/^[0-9]?[0-9]?[0-9]$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" }
          },
          "$other": { ".validate": false }
        },

        "wordscrambleTyping": {
          ".validate": "!root.child('games/' + $room + '/closedAt').exists()",
          "$seat": {
            ".write": "auth != null && root.child('games/' + $room + '/meta/gameSlug').val() == 'wordscramble' && root.child('games/' + $room + '/members/' + auth.uid).val() == $seat",
            ".validate": "newData.hasChildren(['at'])",
            "at": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    },

    "queue": {
      "$slug": {
        "$lang": {
          ".read": "auth != null",
          "$room": {
            ".write": "auth != null && ((newData.exists() && newData.parent().parent().parent().parent().child('games/' + $room + '/meta/gameSlug').val() == $slug && newData.parent().parent().parent().parent().child('games/' + $room + '/meta/publicLang').val() == $lang && (root.child('games/' + $room + '/members/' + auth.uid).exists() || (!root.child('games/' + $room + '/meta').exists() && newData.parent().parent().parent().parent().child('games/' + $room + '/meta/createdBy').val() == auth.uid))) || (!newData.exists() && (root.child('games/' + $room + '/members/' + auth.uid).exists() || !root.child('games/' + $room + '/meta').exists() || data.child('updatedAt').val() < now - 60000)))",
            ".validate": "newData.hasChildren(['players', 'updatedAt']) && !root.child('games/' + $room + '/closedAt').exists()",
            "players": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8" },
            "updatedAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "roomsByName": {
      "$nameKey": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.parent().parent().child('games/' + newData.val() + '/meta/createdBy').val() == auth.uid && newData.parent().parent().child('games/' + newData.val() + '/meta/nameKey').val() == $nameKey) || (data.exists() && !newData.exists() && root.child('games/' + data.val() + '/meta/createdBy').val() == auth.uid))",
        ".validate": "$nameKey.length >= 3 && $nameKey.length <= 40 && $nameKey.matches(/^[a-z0-9-]+$/) && newData.isString() && newData.val().length == 6"
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "rooms": {
          ".validate": "newData.hasChildren()",
          "$room": {
            ".validate": "$room.length == 6 && newData.hasChildren(['gameSlug', 'addedAt'])",
            "gameSlug": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "addedAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "createdByMe": { ".validate": "newData.isBoolean()" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "$other": { ".validate": false }
          }
        },
        "visits": {
          "$day": {
            ".validate": "$day.matches(/^20[0-9][0-9][01][0-9][0-3][0-9]$/) && newData.hasChildren()",
            "$room": {
              ".validate": "newData.hasChildren(['gameSlug', 'at']) && root.child('games/' + $room + '/members/' + $uid).exists() && root.child('games/' + $room + '/meta/gameSlug').val() == newData.child('gameSlug').val()",
              "gameSlug": { ".validate": "newData.isString()" },
              "at": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 172800000" },
              "$other": { ".validate": false }
            }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
