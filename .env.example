# Firebase Web SDK config for this game's Realtime Database.
# Copy this file to .env.local and fill in values from your Firebase project's
# Project settings > General > Your apps > Web app > SDK setup and configuration.
#
# All variables here are safe to expose to the client (NEXT_PUBLIC_*) - this is
# how every Firebase web app ships. Leave them unset to use local test mode
# (localStorage, synced across tabs on one machine, no cross-device play).

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The owner's /admin dashboard (server only - never prefix these with NEXT_PUBLIC_).
# Leave unset to keep /admin off. See README "The admin dashboard".
# ADMIN_PASSWORD=
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# Against the emulators, the admin SDK needs no key - set this instead:
# FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000

# Dev only - leave unset normally. To run against the local emulators
# (`npx firebase emulators:start --only auth,database --project demo-game-room`)
# instead of a real project, see README "Testing against the emulators".
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
